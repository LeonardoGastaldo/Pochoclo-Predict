# Secretos
.env

# Datos (se regeneran ejecutando 01_extraccion_datos.ipynb)
data/raw/*.csv
data/processed/*.csv
!data/raw/.gitkeep
!data/processed/.gitkeep

# Modelos entrenados (pesados, se regeneran con 04_modelos_predictivos.ipynb)
models/*.pkl
!models/.gitkeep

# Python
__pycache__/
*.pyc
.ipynb_checkpoints/

# Artefactos de entrenamiento de CatBoost
catboost_info/

# Entornos
.venv/
env/

# Scripts auxiliares para generar los notebooks (no se usan en tiempo de
# ejecucion, solo durante el desarrollo; el codigo real vive en los .ipynb)
_build/

# Prototipos personales previos al proyecto (no son parte del pipeline, no se suben)
legacy/
